# TrafficTwin Frontend Environment Configuration
# Copy this file to .env.local for local development
# In Vercel deployment: Add VITE_API_BASE_URL to Vercel Project Settings -> Environment Variables

# For Local Development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# For Production (configured in Vercel UI with your actual deployed backend URL):
# VITE_API_BASE_URL=https://your-traffic-backend-domain.com
